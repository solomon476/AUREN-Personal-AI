# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Supabase Auth & JWT Configuration
# Required for token validation on protected endpoints
SUPABASE_URL=https://your-project-ref.supabase.co
# Standard Supabase Anon Key (public client key for standard operations)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase JWT Secret (used for verifying symmetric HS256 tokens offline)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Supabase JWKS URL (optional: used for asymmetric ES256 key verification)
# Default is https://<SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# AI Provider Configuration (Pluggable: gemini, openai, anthropic, or custom)
LLM_PROVIDER=gemini
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-2.5-flash

# Embedding Provider Configuration (Pluggable)
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=gemini-embedding-2

# Memory Background Worker Configuration
# Uses dedicated service login role (auren_worker is NOLOGIN NOINHERIT)
WORKER_DATABASE_URL=postgresql://auren_worker_service:your_secure_worker_password@localhost:54322/postgres
MEMORY_WORKER_ENABLED=true
MEMORY_WORKER_POLL_INTERVAL_SECONDS=2.0
MEMORY_WORKER_BATCH_SIZE=5
MEMORY_WORKER_LEASE_SECONDS=300
MEMORY_WORKER_CONCURRENCY=2

# Journal Privacy & Consent Configuration
# Cryptographic HMAC secret for signing and verifying journal access consent tokens.
# Required in ALL environments (fail-closed; no default fallback).
# Must be at least 32 characters (256 bits) in staging/production, at least 16 in dev/test.
# Generate securely via:
#   OpenSSL: openssl rand -hex 32
#   Python:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JOURNAL_HMAC_SECRET=generate-a-secure-random-32-byte-hex-or-urlsafe-secret


